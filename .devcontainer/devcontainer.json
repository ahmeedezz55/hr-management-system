{
  // =====================================================================
  // GitHub Codespaces / VS Code Dev Container
  // One-click: .NET 10 SDK + SQL Server 2022 are provisioned automatically,
  // migrations + seed data apply at first launch, and the app starts and
  // opens in the browser on port 5188 — no manual commands needed.
  // =====================================================================
  "name": "HR Management System",

  "dockerComposeFile": "docker-compose.yml",

  // The service inside .devcontainer/docker-compose.yml that hosts the IDE.
  "service": "dev",

  // The repository is mounted under /workspaces/<repo-name> (GitHub
  // Codespaces convention) - open the repo itself as the workspace root.
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",

  // App (HTTP) and SQL Server ports. The app auto-starts on 5188 and the
  // browser opens it automatically via onAutoForward below.
  "forwardPorts": [5188, 1433],

  "portsAttributes": {
    "5188": {
      "label": "HR Management System (App)",
      "onAutoForward": "openBrowser",
      "visibility": "private"
    },
    "1433": {
      "label": "SQL Server",
      "onAutoForward": "silent",
      "visibility": "private"
    }
  },

  // Restore + build the solution once when the container is created, so the
  // first `dotnet run` (started by postStartCommand) is instant.
  "postCreateCommand": "dotnet restore HR.System.sln && dotnet build HR.System.sln --no-restore",

  // Start the web app on every container start (HTTP on port 5188).
  // Migrations + seed data apply automatically at startup (DbSeeder),
  // and the forwarded port opens in the browser automatically.
  "postStartCommand": "bash .devcontainer/start-app.sh",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csdevkit",
        "ms-dotnettools.csharp",
        "ms-dotnettools.vscode-dotnetruntime"
      ]
    }
  },

  // Optional: pass your Groq API key into the Codespace. Recommended:
  // add a repo secret named GROQ_API_KEY (Settings -> Secrets and variables
  // -> Codespaces). Without it, the AI Assistant is simply disabled with a
  // clear message - the rest of the app works normally.
  "remoteEnv": {
    "Groq__ApiKey": "${localEnv:GROQ_API_KEY}"
  },

  "remoteUser": "vscode"
}
