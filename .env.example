# =====================================================================
# HR Management System - environment variables template
#
# Copy this file to ".env" (same folder as docker-compose.yml) and fill
# in your values. docker compose reads .env automatically.
#     cp .env.example .env
# =====================================================================

# ---- SQL Server 2022 (docker-compose db service) ----
# Must be at least 8 chars incl. 3 of 4 categories (upper/lower/digit/symbol).
MSSQL_SA_PASSWORD=Your_password123

# ---- Groq AI Assistant (optional) ----
# Get a free key at https://console.groq.com/keys
# Leave empty to run the app without the AI Assistant.
GROQ_API_KEY=
