<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - نظام الموارد البشرية</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.rtl.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="~/css/site.css?v=2" asp-append-version="true" />
</head>
<body>
    <div class="d-flex" id="wrapper">
        <!-- Sidebar -->
        <div class="sidebar" id="sidebar-wrapper">
            <div class="sidebar-heading text-center py-3 text-white fw-bold border-bottom">
                <i class="fas fa-building me-2"></i>نظام الموارد البشرية
            </div>
            
            <div class="list-group list-group-flush my-3">
                <a asp-controller="Dashboard" asp-action="Index" class="list-group-item list-group-item-action bg-transparent text-white">
                    <i class="fas fa-tachometer-alt me-2"></i>لوحة التحكم
                </a>
                <a asp-controller="Employees" asp-action="Index" class="list-group-item list-group-item-action bg-transparent text-white">
                    <i class="fas fa-users me-2"></i>الموظفون
                </a>
                <a asp-controller="Departments" asp-action="Index" class="list-group-item list-group-item-action bg-transparent text-white">
                    <i class="fas fa-building me-2"></i>الأقسام
                </a>
                <a asp-controller="Attendance" asp-action="Index" class="list-group-item list-group-item-action bg-transparent text-white">
                    <i class="fas fa-clock me-2"></i>الحضور
                </a>
                <a asp-controller="Leaves" asp-action="Index" class="list-group-item list-group-item-action bg-transparent text-white">
                    <i class="fas fa-calendar-alt me-2"></i>الإجازات
                </a>
            </div>

            <div class="sidebar-widgets">
                <button class="btn btn-sm w-100 text-white mb-2 widget-btn" onclick="togglePanel('calcPanel')" type="button">
                    <i class="fas fa-calculator me-2"></i>الآلة الحاسبة
                </button>
                
                <div id="calcPanel" class="widget-panel" style="display:none;">
                    <div class="p-2 bg-white bg-opacity-10 rounded mb-2">
                        <ul class="nav nav-tabs nav-fill mb-2" style="font-size: 0.75rem;">
                            <li class="nav-item"><button class="nav-link active text-white" onclick="showCalcTab('basic')" type="button" style="padding: 4px;">عادي</button></li>
                            <li class="nav-item"><button class="nav-link text-white" onclick="showCalcTab('salary')" type="button" style="padding: 4px;">رواتب</button></li>
                            <li class="nav-item"><button class="nav-link text-white" onclick="showCalcTab('leave')" type="button" style="padding: 4px;">إجازات</button></li>
                        </ul>

                        <div id="calcTab-basic">
                            <input type="text" class="form-control form-control-sm mb-2 calc-display" id="calcDisplay" readonly />
                            <div class="row g-1">
                                <div class="col-3"><button class="btn btn-sm btn-light w-100" onclick="calcInput('7')" type="button">7</button></div>
                                <div class="col-3"><button class="btn btn-sm btn-light w-100" onclick="calcInput('8')" type="button">8</button></div>
                                <div class="col-3"><button class="btn btn-sm btn-light w-100" onclick="calcInput('9')" type="button">9</button></div>
                                <div class="col-3"><button class="btn btn-sm btn-warning w-100" onclick="calcOp('/')" type="button">÷</button></div>
                                <div class="col-3"><button class="btn btn-sm btn-light w-100" onclick="calcInput('4')" type="button">4</button></div>
                                <div class="col-3"><button class="btn btn-sm btn-light w-100" onclick="calcInput('5')" type="button">5</button></div>
                                <div class="col-3"><button class="btn btn-sm btn-light w-100" onclick="calcInput('6')" type="button">6</button></div>
                                <div class="col-3"><button class="btn btn-sm btn-warning w-100" onclick="calcOp('*')" type="button">×</button></div>
                                <div class="col-3"><button class="btn btn-sm btn-light w-100" onclick="calcInput('1')" type="button">1</button></div>
                                <div class="col-3"><button class="btn btn-sm btn-light w-100" onclick="calcInput('2')" type="button">2</button></div>
                                <div class="col-3"><button class="btn btn-sm btn-light w-100" onclick="calcInput('3')" type="button">3</button></div>
                                <div class="col-3"><button class="btn btn-sm btn-warning w-100" onclick="calcOp('-')" type="button">-</button></div>
                                <div class="col-3"><button class="btn btn-sm btn-danger w-100" onclick="calcClear()" type="button">C</button></div>
                                <div class="col-3"><button class="btn btn-sm btn-light w-100" onclick="calcInput('0')" type="button">0</button></div>
                                <div class="col-3"><button class="btn btn-sm btn-success w-100" onclick="calcResult()" type="button">=</button></div>
                                <div class="col-3"><button class="btn btn-sm btn-warning w-100" onclick="calcOp('+')" type="button">+</button></div>
                            </div>
                        </div>

                        <div id="calcTab-salary" style="display:none;">
                            <input type="number" class="form-control form-control-sm mb-2" id="basicSalary" placeholder="الراتب الأساسي" />
                            <input type="number" class="form-control form-control-sm mb-2" id="allowances" placeholder="البدلات (سكن، نقل، غذاء)" />
                            <input type="number" class="form-control form-control-sm mb-2" id="deductions" placeholder="الخصومات (تأمينات، غرامات)" />
                            <button class="btn btn-sm btn-success w-100 mb-2" onclick="calculateSalary()" type="button">احسب الراتب الصافي</button>
                            <div class="p-2 bg-white bg-opacity-25 rounded text-white text-center">
                                <small>الراتب الصافي: <strong id="netSalary">0</strong> ريال</small>
                            </div>
                        </div>

                        <div id="calcTab-leave" style="display:none;">
                            <div class="mb-2">
                                <label class="text-white small mb-1">بداية الإجازة:</label>
                                <select class="form-select form-select-sm mb-1" id="startType" onchange="toggleDateType('start')">
                                    <option value="gregorian">ميلادي</option>
                                    <option value="hijri">هجري</option>
                                </select>
                                <input type="date" class="form-control form-control-sm mb-1" id="startDate" />
                                <div id="startHijri" style="display:none;">
                                    <div class="row g-1">
                                        <div class="col-4"><input type="number" class="form-control form-control-sm" id="startHDay" placeholder="يوم" min="1" max="30" /></div>
                                        <div class="col-4"><input type="number" class="form-control form-control-sm" id="startHMonth" placeholder="شهر" min="1" max="12" /></div>
                                        <div class="col-4"><input type="number" class="form-control form-control-sm" id="startHYear" placeholder="سنة" /></div>
                                    </div>
                                </div>
                            </div>
                            <div class="mb-2">
                                <label class="text-white small mb-1">نهاية الإجازة:</label>
                                <select class="form-select form-select-sm mb-1" id="endType" onchange="toggleDateType('end')">
                                    <option value="gregorian">ميلادي</option>
                                    <option value="hijri">هجري</option>
                                </select>
                                <input type="date" class="form-control form-control-sm mb-1" id="endDate" />
                                <div id="endHijri" style="display:none;">
                                    <div class="row g-1">
                                        <div class="col-4"><input type="number" class="form-control form-control-sm" id="endHDay" placeholder="يوم" min="1" max="30" /></div>
                                        <div class="col-4"><input type="number" class="form-control form-control-sm" id="endHMonth" placeholder="شهر" min="1" max="12" /></div>
                                        <div class="col-4"><input type="number" class="form-control form-control-sm" id="endHYear" placeholder="سنة" /></div>
                                    </div>
                                </div>
                            </div>
                            <button class="btn btn-sm btn-success w-100 mb-2" onclick="calculateLeaveDays()" type="button">احسب أيام الإجازة</button>
                            <div class="p-2 bg-white bg-opacity-25 rounded text-white text-center">
                                <small>عدد أيام الإجازة: <strong id="leaveDays">0</strong> يوم</small>
                            </div>
                        </div>
                    </div>
                </div>

                <button class="btn btn-sm w-100 text-white mb-2 widget-btn" onclick="togglePanel('aiPanel')" type="button">
                    <i class="fas fa-robot me-2"></i>المساعد الذكي
                </button>
                
                <div id="aiPanel" class="widget-panel" style="display:none;">
                    <div class="p-2 bg-white bg-opacity-10 rounded">
                        <div class="chat-container" style="height: 400px; overflow-y: auto; background: rgba(255,255,255,0.1); border-radius: 4px; padding: 5px; margin-bottom: 5px;">
                            <div id="chatMessages"></div>
                        </div>
                        <div class="input-group input-group-sm">
                            <input type="text" class="form-control" id="chatInput" placeholder="اكتب هنا..." />
                            <button class="btn btn-success" onclick="sendMessage()" type="button"><i class="fas fa-paper-plane"></i></button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Page Content -->
        <div id="page-content-wrapper">
            <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom shadow-sm">
                <div class="container-fluid">
                    <button class="btn btn-primary" id="sidebarToggle" type="button"><i class="fas fa-bars"></i></button>
                    <div class="collapse navbar-collapse" id="navbarNav">
                        <ul class="navbar-nav me-auto"></ul>
                        <partial name="_LoginPartial" />
                    </div>
                </div>
            </nav>
            <div class="container-fluid px-4 py-4">
                <main role="main">@RenderBody()</main>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js?v=2" asp-append-version="true"></script>
</body>
</html>