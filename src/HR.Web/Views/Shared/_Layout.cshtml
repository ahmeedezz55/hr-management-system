@using System.Globalization
@{
    var isRtl = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft;
    var dir = isRtl ? "rtl" : "ltr";
    var bootstrapCss = isRtl
        ? "https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css"
        : "https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css";
}
<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.TwoLetterISOLanguageName" dir="@dir">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - نظام الموارد البشرية</title>
    <link rel="stylesheet" href="@bootstrapCss" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="app-body">
    <aside class="app-sidebar">
        <div class="brand">
            <i class="bi bi-people-fill"></i>
            <span>نظام الموارد البشرية</span>
        </div>
        <nav class="nav flex-column px-2">
            <a class="nav-link" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-speedometer2"></i> لوحة التحكم</a>
            <a class="nav-link" asp-controller="Employees" asp-action="Index"><i class="bi bi-person-badge"></i> الموظفون</a>
            <a class="nav-link" asp-controller="Departments" asp-action="Index"><i class="bi bi-building"></i> الأقسام</a>
            <a class="nav-link" asp-controller="Attendance" asp-action="Index"><i class="bi bi-clock-history"></i> الحضور</a>
            <a class="nav-link" asp-controller="Leaves" asp-action="Index"><i class="bi bi-calendar-check"></i> الإجازات</a>
        </nav>
    </aside>

    <div class="app-main">
        <header class="app-topbar">
            <div class="d-flex align-items-center gap-2">
                <span class="text-muted small">المملكة العربية السعودية</span>
            </div>
            <div class="d-flex align-items-center gap-2">
                <form asp-controller="Culture" asp-action="Set" method="post" class="d-flex gap-1">
                    <input type="hidden" name="returnUrl" value="@($"{Context.Request.Path}{Context.Request.QueryString}")" />
                    <button class="btn btn-sm btn-outline-secondary" name="culture" value="ar-SA" type="submit">العربية</button>
                    <button class="btn btn-sm btn-outline-secondary" name="culture" value="en-US" type="submit">EN</button>
                </form>
                <partial name="_LoginPartial" />
            </div>
        </header>

        <main class="app-content">
            @if (TempData["Success"] is string success)
            {
                <div class="alert alert-success alert-dismissible fade show">@success
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["Error"] is string error)
            {
                <div class="alert alert-danger alert-dismissible fade show">@error
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @RenderBody()
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.21.0/dist/jquery.validate.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@4.0.0/dist/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
