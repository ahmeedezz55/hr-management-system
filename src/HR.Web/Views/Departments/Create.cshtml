@model Department
@{
    ViewData["Title"] = "إضافة قسم";
}

<h3>إضافة قسم</h3>
<form asp-action="Create" method="post" class="card card-body shadow-sm">
    <div class="row g-3">
        <div class="col-md-4">
            <label asp-for="Code" class="form-label">الرمز</label>
            <input asp-for="Code" class="form-control" />
        </div>
        <div class="col-md-4">
            <label asp-for="NameAr" class="form-label">الاسم عربي</label>
            <input asp-for="NameAr" class="form-control" />
        </div>
        <div class="col-md-4">
            <label asp-for="NameEn" class="form-label">الاسم إنجليزي</label>
            <input asp-for="NameEn" class="form-control" />
        </div>
        <div class="col-12">
            <label asp-for="DescriptionAr" class="form-label">الوصف</label>
            <textarea asp-for="DescriptionAr" class="form-control"></textarea>
        </div>
    </div>
    <div class="mt-3">
        <button class="btn btn-success" type="submit">حفظ</button>
        <a asp-action="Index" class="btn btn-outline-secondary">رجوع</a>
    </div>
</form>
