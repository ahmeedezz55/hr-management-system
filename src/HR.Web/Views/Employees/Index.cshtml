@model IEnumerable<Employee>
@{
    ViewData["Title"] = "الموظفون";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">إدارة الموظفين</h3>
    @if (User.IsInRole(AppRoles.Admin) || User.IsInRole(AppRoles.Hr))
    {
        <a class="btn btn-success" asp-action="Create"><i class="bi bi-plus-lg"></i> موظف جديد</a>
    }
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-4">
        <input class="form-control" name="search" value="@ViewBag.Search" placeholder="بحث بالاسم / رقم الموظف / الهوية" />
    </div>
    <div class="col-md-2">
        <button class="btn btn-outline-primary w-100" type="submit">بحث</button>
    </div>
</form>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover mb-0 align-middle">
            <thead class="table-light">
                <tr>
                    <th>رقم الموظف</th>
                    <th>الاسم</th>
                    <th>القسم</th>
                    <th>المسمى</th>
                    <th>الهوية / الإقامة</th>
                    <th>الحالة</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var e in Model)
            {
                <tr>
                    <td>@e.EmployeeNumber</td>
                    <td>
                        <div>@e.FullNameAr</div>
                        <small class="text-muted">@e.FullNameEn</small>
                    </td>
                    <td>@e.Department.NameAr</td>
                    <td>@e.JobTitleAr</td>
                    <td>@(e.NationalId ?? e.IqamaNumber)</td>
                    <td>
                        <span class="badge @(e.Status == EmploymentStatus.Active ? "bg-success" : "bg-secondary")">
                            @e.Status
                        </span>
                    </td>
                    <td class="text-nowrap">
                        <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@e.Id">عرض</a>
                        @if (User.IsInRole(AppRoles.Admin) || User.IsInRole(AppRoles.Hr))
                        {
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@e.Id">تعديل</a>
                            <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@e.Id">حذف</a>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
