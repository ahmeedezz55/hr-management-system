@{
    ViewData["Title"] = "الموظفون";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="text-primary fw-bold">
        <i class="fas fa-users me-2"></i>الموظفون
    </h2>
    <div>
        <button class="btn btn-primary" onclick="addExcelRow('employeesTable')">
            <i class="fas fa-plus me-1"></i>إضافة موظف
        </button>
        <button class="btn btn-success" onclick="exportToCSV('employeesTable')">
            <i class="fas fa-file-csv me-1"></i>تصدير CSV
        </button>
    </div>
</div>

<!-- Toolbar -->
<div class="excel-toolbar">
    <div class="excel-search">
        <input type="text" class="form-control" placeholder="🔍 بحث في الجدول..." oninput="searchExcelTable('employeesTable', this.value)" />
    </div>
    <button class="btn btn-outline-primary btn-sm" onclick="addExcelRow('employeesTable')">
        <i class="fas fa-plus me-1"></i>صف جديد
    </button>
    <button class="btn btn-outline-danger btn-sm" onclick="if(confirm('هل أنت متأكد من حذف جميع الصفوف؟')) location.reload()">
        <i class="fas fa-redo me-1"></i>إعادة تعيين
    </button>
</div>

<!-- Excel-like Table -->
<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="excel-table" id="employeesTable">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>الاسم الكامل</th>
                        <th>البريد الإلكتروني</th>
                        <th>رقم الهاتف</th>
                        <th>القسم</th>
                        <th>المسمى الوظيفي</th>
                        <th>الراتب الأساسي</th>
                        <th>تاريخ التعيين</th>
                        <th>الحالة</th>
                        <th>إجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td><input type="text" value="1" /></td>
                        <td><input type="text" value="أحمد العلي" /></td>
                        <td><input type="email" value="ahmed@hr.sa" /></td>
                        <td><input type="text" value="0501234567" /></td>
                        <td>
                            <select>
                                <option selected>الموارد البشرية</option>
                                <option>تقنية المعلومات</option>
                                <option>المالية</option>
                                <option>الإدارة</option>
                            </select>
                        </td>
                        <td><input type="text" value="مدير HR" /></td>
                        <td><input type="number" value="15000" /></td>
                        <td><input type="date" value="2024-01-01" /></td>
                        <td>
                            <select>
                                <option selected>نشط</option>
                                <option>غير نشط</option>
                                <option>إجازة</option>
                            </select>
                        </td>
                        <td>
                            <button class="btn btn-sm btn-danger" onclick="deleteExcelRow(this)" type="button">
                                <i class="fas fa-trash"></i>
                            </button>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="mt-3 text-muted small">
    <i class="fas fa-info-circle me-1"></i>
    يمكنك النقر على أي خلية لتعديلها مباشرة. اضغط على "إضافة موظف" لإضافة صف جديد.
</div>